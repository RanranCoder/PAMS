# 复制为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会提交到仓库。
# 服务器上部署时用 `openssl rand -hex 32` 生成随机密码/密钥。

# MySQL root 密码
MYSQL_ROOT_PASSWORD=change_me_root_password
# 应用连接 MySQL 的账号
MYSQL_USER=pams
MYSQL_PASSWORD=change_me_app_password
# JWT 签名密钥（随机 64 字符以上长字符串）
PAMS_JWT_SECRET=change_me_jwt_secret_64_plus_chars_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
